{
  "name": "omnipdf-studio",
  "version": "1.4.1",
  "description": "OmniPDF Studio - A mais completa suíte de visualização e edição de PDF com TrueEdit, IA e ferramentas 100% offline",
  "author": "Henrique Bezerra Dos Santos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Henrique1601/OmniPDF-Studio.git"
  },
  "keywords": [
    "pdf",
    "pdf-editor",
    "trueedit",
    "electron",
    "react",
    "typescript",
    "tesseract",
    "ocr",
    "gemini-api",
    "offline-first",
    "desktop-app",
    "windows"
  ],
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --dir",
    "dist": "tsc && vite build && electron-builder",
    "dist:portable": "tsc && vite build && electron-builder --win portable",
    "sync:release": "node scripts/sync-release.js",
    "deploy:landing": "cd landing && npx vercel --prod --yes"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.henrique.omnipdfstudio",
    "productName": "OmniPDF Studio",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OmniPDF Studio"
    },
    "publish": {
      "provider": "github",
      "owner": "Henrique1601",
      "repo": "OmniPDF-Studio"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Documento PDF",
        "description": "Documento em Formato PDF",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ]
  }
}
